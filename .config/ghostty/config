# Ghostty 1.3.1 + herdr (macOS / Apple Silicon).
# Tabs, panes, workspace titles and cwd tracking are managed by herdr.

# A GUI launched from a herdr pane can inherit its nesting marker and pane IDs.
# This is a new terminal client, not a nested pane. Keep socket/session routing.
command = direct:/usr/bin/env -u HERDR_ENV -u HERDR_PANE_ID -u HERDR_TAB_ID -u HERDR_WORKSPACE_ID /opt/homebrew/bin/herdr
theme = Catppuccin Mocha

font-family = Moralerspace Argon NF
font-size = 18
window-title-font-family = Moralerspace Argon NF

window-width = 150
window-height = 50
window-decoration = none
window-save-state = never
window-padding-x = 5
window-padding-y = 10,0
window-padding-color = background

background = #1e1e2e
background-opacity = 0.9
background-blur = 30
background-image = ~/.config/ghostty/background.jpg
background-image-opacity = 0.08
background-image-fit = cover
background-image-position = center

scrollback-limit = 50000000
split-divider-color = #6c7086
unfocused-split-opacity = 1

mouse-hide-while-typing = true
clipboard-read = allow
clipboard-write = allow
# The child process is herdr, not zsh; do not force zsh injection into it.
shell-integration = detect
confirm-close-surface = always

# Match the tmux/WezTerm workflow where cwd follows the focused pane.
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Match WezTerm's explicit bindings; leave other keys to herdr/the shell.
keybind = clear
keybind = super+shift+n=new_window
keybind = super+v=paste_from_clipboard
keybind = super+plus=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+0=reset_font_size
keybind = super+ctrl+enter=toggle_fullscreen

# Send the same bytes as WezTerm (herdr prefix = Ctrl+G).
keybind = super+n=text:\x0e
keybind = ctrl+tab=text:\x07n
keybind = ctrl+shift+tab=text:\x07p
keybind = super+t=text:\x07c

# Ghostty configuration reload (herdr reload remains Ctrl+G, Shift+R).
keybind = super+shift+comma=reload_config
